# Tashheer environment variables
# Copy this file to .env.local and fill in real values.
# .env* is gitignored so real values never end up in commits.

# --- Supabase (Phase 1) ---
# Get from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Marketing API (Phase 4) ---
# Get from developers.facebook.com -> your app -> Settings -> Basic
META_APP_ID=
META_APP_SECRET=
# System-user long-lived token for Tashheer's Business Manager.
# Scope: ads_management, ads_read, business_management, pages_show_list,
#        pages_read_engagement, pages_manage_ads (as required by Meta).
META_SYSTEM_USER_TOKEN=
# Tashheer Business Manager ID (Business info -> Business Manager ID).
META_BUSINESS_ID=
META_GRAPH_API_VERSION=v21.0

# --- App ---
# Public site URL used for OAuth callbacks and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
